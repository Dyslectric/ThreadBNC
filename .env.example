# Copy to .env next to compose.yaml and fill in. Never commit .env.

# Required. Generate each with: openssl rand -hex 32
THREADBNC_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
# Signs login sessions. If empty, one is generated and kept in the media volume.
THREADBNC_SECRET_KEY=
# Encrypts stored Lemmy/PieFed session tokens (Accounts page). If empty, one is
# generated and kept in the media volume -- deliberately not in the database.
THREADBNC_CREDENTIALS_KEY=

# Published image to run. Leave unset to build locally from this checkout.
# THREADBNC_IMAGE=ghcr.io/<github-user>/threadbnc:latest

# Optional
# THREADBNC_API_TOKEN=          # enables POST /archive with "Authorization: Bearer <token>"
# THREADBNC_HTTPS_ONLY=1        # secure cookies; set 0 only for plain-http testing
# THREADBNC_BIND=127.0.0.1      # interface the UI listens on (keep loopback behind a proxy)
# THREADBNC_PORT=8080
# THREADBNC_MEDIA_MAX_MB=25
# THREADBNC_TRASH_DAYS=30

# Behind a proxy that signs people in (e.g. Traefik + Authentik forward auth).
# The proxy must add THREADBNC_PROXY_SECRET as the X-ThreadBNC-Proxy-Secret
# header; only then is the user header trusted. THREADBNC_PASSWORD becomes an
# optional fallback.
# THREADBNC_PROXY_AUTH_HEADER=X-authentik-username
# THREADBNC_PROXY_SECRET=        # openssl rand -hex 32
# THREADBNC_PROXY_ALLOWED_USERS= # comma-separated; blank = whoever the proxy lets through
# THREADBNC_PROXY_LOGOUT_URL=/outpost.goauthentik.io/sign_out
